<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pool Leaderboard</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      background: #f5f5f0;
      color: #1a1a1a;
      min-height: 100vh;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 2rem 1rem;
    }

    .board {
      width: 100%;
      max-width: 540px;
    }

    .header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .title {
      font-size: 22px;
      font-weight: 500;
      color: #1a1a1a;
      letter-spacing: -0.3px;
    }

    .subtitle {
      font-size: 13px;
      color: #888;
      margin-top: 2px;
    }

    .meta {
      text-align: right;
    }

    .refresh-btn {
      font-size: 13px;
      color: #888;
      background: none;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 0;
      transition: color 0.15s;
    }

    .refresh-btn:hover { color: #1a1a1a; }

    .updated {
      font-size: 11px;
      color: #aaa;
      margin-top: 2px;
    }

    .row {
      display: grid;
      grid-template-columns: 36px 1fr auto;
      align-items: center;
      gap: 12px;
      background: #fff;
      border: 0.5px solid #e2e2de;
      border-radius: 10px;
      padding: 12px 16px;
      margin-bottom: 6px;
      transition: background 0.12s;
    }

    .row:hover { background: #fafaf8; }

    .row.rank-1 { border-color: #FAC775; background: #FEFBF4; }
    .row.rank-2 { border-color: #D3D1C7; }
    .row.rank-3 { border-color: #F5C4B3; background: #FEFAF8; }

    .rank {
      font-size: 20px;
      text-align: center;
      line-height: 1;
    }

    .rank-num {
      font-size: 13px;
      font-weight: 500;
      color: #aaa;
      text-align: center;
    }

    .name {
      font-size: 15px;
      font-weight: 400;
      color: #1a1a1a;
    }

    .bar-wrap {
      height: 3px;
      background: #ebebea;
      border-radius: 2px;
      margin-top: 5px;
    }

    .bar {
      height: 3px;
      border-radius: 2px;
      background: #7F77DD;
      transition: width 0.4s ease;
    }

    .pts-wrap { text-align: right; }

    .pts {
      font-size: 16px;
      font-weight: 500;
      color: #1a1a1a;
    }

    .pts-label {
      font-size: 11px;
      color: #aaa;
    }

    .loading {
      text-align: center;
      padding: 3rem 1rem;
      font-size: 14px;
      color: #888;
    }

    .error {
      text-align: center;
      padding: 2rem 1rem;
      font-size: 14px;
      color: #c04040;
    }

    @media (prefers-color-scheme: dark) {
      body { background: #1a1a18; color: #e8e8e4; }
      .title { color: #e8e8e4; }
      .row { background: #242422; border-color: #333331; }
      .row:hover { background: #2a2a28; }
      .row.rank-1 { background: #2d2a1e; border-color: #7a5a1a; }
      .row.rank-3 { background: #2a2220; border-color: #7a4030; }
      .name { color: #e8e8e4; }
      .pts { color: #e8e8e4; }
      .bar-wrap { background: #333; }
      .refresh-btn { color: #666; }
      .refresh-btn:hover { color: #e8e8e4; }
    }
  </style>
</head>
<body>

<div class="board">
  <div class="header">
    <div>
      <div class="title">⚽ Pool leaderboard</div>
      <div class="subtitle">World Cup 2026</div>
    </div>
    <div class="meta">
      <button class="refresh-btn" onclick="load()" aria-label="Refresh leaderboard">
        ↻ Refresh
      </button>
      <div class="updated" id="updated-time"></div>
    </div>
  </div>
  <div id="board-body">
    <div class="loading">Loading scores…</div>
  </div>
</div>

<script>
  const CSV_URL =
    "https://docs.google.com/spreadsheets/d/e/2PACX-1vTQPFnmAZG7QiOJTpcCWUSZQbkN90EAJfJQaf8BacjBBRkNzloun10HnMdLBzFWZt-qU4JHZaVb3I80/pub?gid=1567052873&single=true&output=csv";

  async function load() {
    try {
      const res = await fetch(CSV_URL + "&nocache=" + Date.now());
      if (!res.ok) throw new Error("Network response was not ok");
      const text = await res.text();

      const rows = text
        .trim()
        .split("\n")
        .slice(1)
        .map(r => r.split(","))
        .filter(r => r[1] && r[1].trim())
        .map(r => ({ name: r[1].trim(), pts: parseInt(r[13], 10) || 0 }))
        .filter(r => r.pts > 0)
        .sort((a, b) => b.pts - a.pts);

      if (rows.length === 0) {
        document.getElementById("board-body").innerHTML =
          "<div class='loading'>No scores yet — check back soon.</div>";
        return;
      }

      const max = rows[0].pts;

      const html = rows.map((p, i) => {
        const medal = i === 0 ? "🥇" : i === 1 ? "🥈" : i === 2 ? "🥉" : null;
        const rankDisplay = medal
          ? `<div class="rank">${medal}</div>`
          : `<div class="rank-num">${i + 1}</div>`;
        const rowClass = i < 3 ? `rank-${i + 1}` : "";
        const pct = Math.round((p.pts / max) * 100);

        return `<div class="row ${rowClass}" role="listitem">
          ${rankDisplay}
          <div>
            <div class="name">${escHtml(p.name)}</div>
            <div class="bar-wrap"><div class="bar" style="width:${pct}%"></div></div>
          </div>
          <div class="pts-wrap">
            <div class="pts">${p.pts}</div>
            <div class="pts-label">pts</div>
          </div>
        </div>`;
      }).join("");

      document.getElementById("board-body").innerHTML = html;
      document.getElementById("updated-time").textContent =
        "Updated " + new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    } catch (err) {
      document.getElementById("board-body").innerHTML =
        "<div class='error'>Couldn't load scores. Check the sheet URL or try again.</div>";
      console.error(err);
    }
  }

  function escHtml(str) {
    return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
  }

  load();
  setInterval(load, 60 * 1000); // auto-refresh every 60 seconds
</script>

</body>
</html>
